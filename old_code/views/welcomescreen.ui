}

QLineEdit {
	border: 1px solid gray;        /* Set the border */
	border-radius: 5px;          /* Round the corners */
	padding: 1px;                /* Space between text and border */
}

QLineEdit::viewport {
	background: transparent;      /* Make viewport background transparent */
	border: none;                 /* Remove viewport border */
}</string>
